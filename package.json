{
  "name": "huntflow",
  "version": "1.0.5",
  "description": "Pentest workflow companion — track targets, sessions, notes, evidence, and findings. Offline-first, zero telemetry.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "huntflow": "./bin/huntflow.mjs"
  },
  "files": [
    "bin",
    "build",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "pentest",
    "penetration-testing",
    "security",
    "vulnerability",
    "tracker",
    "offline",
    "pwa"
  ],
  "homepage": "https://huntflow.xalgorix.com",
  "author": "xalgorix",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "build": "vite build",
    "build:web": "vite build",
    "build:app": "node bin/build-app.mjs",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-readme-screenshots.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:no-clerk": "! grep -rEn '\\b(ClerkInstance|clerkAuthStore|getClerkToken|mountClerk[A-Za-z]*|signInWithClerk|signOutFromClerk|huntflowClerkAppearance|openClerkSubscriptions)\\b' src/ convex/ tests/ && ! grep -rEn '(@clerk/clerk-js|window\\.Clerk\\b)' src/ convex/ tests/",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "prepublishOnly": "npm run build:app",
    "prepare": "node bin/prepare.mjs"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.60.1",
    "@vercel/node": "^5.7.13",
    "chart.js": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.39.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.11",
    "firebase": "^11.10.0",
    "idb": "^7.1.0",
    "lucide-svelte": "^0.300.0",
    "standardwebhooks": "^1.0.0",
    "svelte": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^4.2.3",
    "@types/d3-force": "^3.0.10",
    "autoprefixer": "^10.4.16",
    "fake-indexeddb": "^5.0.2",
    "fast-check": "^4.8.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.14",
    "svelte-check": "^3.6.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.0.0"
  }
}
