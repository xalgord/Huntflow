{
  "name": "huntflow",
  "version": "1.0.8",
  "description": "Local-first workspace for bug bounty hunters and pentesters: import scope and recon (HackerOne, Bugcrowd, subfinder, httpx, nuclei, nmap, Burp), write findings that export to any platform, and deliver PDF reports.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "huntflow": "./bin/huntflow.mjs"
  },
  "files": [
    "bin",
    "build",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "bug-bounty",
    "bugbounty",
    "pentest",
    "penetration-testing",
    "hackerone",
    "bugcrowd",
    "intigriti",
    "yeswehack",
    "recon",
    "nuclei",
    "subfinder",
    "httpx",
    "cvss",
    "vulnerability-report",
    "security",
    "offline",
    "local-first"
  ],
  "homepage": "https://huntflow.xalgorix.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xalgord/huntflow.git"
  },
  "author": "xalgorix",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/postbuild-cf-pages.mjs",
    "build:web": "vite build",
    "build:cf": "vite build --mode cloudflare && node scripts/postbuild-cf-pages.mjs",
    "build:app": "node bin/build-app.mjs",
    "preview": "vite preview",
    "screenshots": "node scripts/capture-readme-screenshots.mjs",
    "test": "vitest",
    "test:e2e": "playwright test",
    "check:no-clerk": "! grep -rEn '\\b(ClerkInstance|clerkAuthStore|getClerkToken|mountClerk[A-Za-z]*|signInWithClerk|signOutFromClerk|huntflowClerkAppearance|openClerkSubscriptions)\\b' src/ server/ tests/ && ! grep -rEn '(@clerk/clerk-js|window\\.Clerk\\b)' src/ server/ tests/",
    "lint": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:server": "tsc -p tsconfig.server.json",
    "cf:migrate": "wrangler d1 migrations apply huntflow --remote",
    "cf:dev": "npm run build:cf && wrangler pages dev build",
    "prepublishOnly": "npm run build:app",
    "prepare": "node bin/prepare.mjs",
    "deploy:cf": "npm run build:cf && wrangler pages deploy build --project-name=huntflow --branch main"
  },
  "dependencies": {
    "@sveltejs/kit": "^2.60.1",
    "ae-cvss-calculator": "^1.0.13",
    "chart.js": "^4.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dompurify": "^3.4.11",
    "firebase": "^11.10.0",
    "idb": "^7.1.0",
    "lucide-svelte": "^0.300.0",
    "svelte": "^4.0.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@playwright/test": "^1.40.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^4.2.3",
    "@types/d3-force": "^3.0.10",
    "autoprefixer": "^10.4.16",
    "fake-indexeddb": "^5.0.2",
    "fast-check": "^4.8.0",
    "jose": "^6.2.18",
    "jsdom": "^24.1.3",
    "postcss": "^8.5.14",
    "standardwebhooks": "^1.3.0",
    "svelte-check": "^3.6.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.0.0",
    "wrangler": "^4.168.0"
  }
}
