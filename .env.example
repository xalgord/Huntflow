# ---------------------------------------------------------------------------
# Browser build settings (read by Vite at build time; all public values)
# ---------------------------------------------------------------------------

# Firebase Auth web config (Firebase console → Project settings → General →
# Your apps → Web app). All four are needed for sign-in; leave them empty to
# build the local-only app with no account features.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Where the cloud API lives. Leave empty on Cloudflare Pages (the API is
# served from the same origin under /api). Builds that run elsewhere — the
# npm CLI, `vite dev` — can point at the hosted API instead:
#   VITE_CLOUD_API_URL=https://huntflow.xalgorix.com
# Set to `off` to build without cloud sync even when Firebase is configured.
VITE_CLOUD_API_URL=

# ---------------------------------------------------------------------------
# Cloud API settings (Cloudflare Pages Functions — NOT read from this file)
# ---------------------------------------------------------------------------
# Bindings and public settings live in wrangler.toml:
#   DB (D1 "huntflow"), EVIDENCE (R2 "huntflow-evidence"),
#   FIREBASE_PROJECT_ID, DODO_API_BASE_URL, DODO_PRO_PRODUCT_ID
#
# Secrets are set once on the Pages project:
#   npx wrangler pages secret put DODO_API_KEY --project-name huntflow
#   npx wrangler pages secret put DODO_WEBHOOK_SIGNING_SECRET --project-name huntflow
#   npx wrangler pages secret put RESEND_API_KEY --project-name huntflow
#
# For `npm run cf:dev` (local Functions), put the same names in a
# `.dev.vars` file next to wrangler.toml (git-ignored).
