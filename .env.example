CONVEX_DEPLOYMENT=
CONVEX_DEPLOY_KEY=

VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=

# Firebase Auth — client-side config. Read these values from the Firebase
# console (Project settings → General → Your apps → Web app config). All
# four are required for the AuthClient to initialize; missing values cause
# the app to fall back to local-only (signed-out) mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Dodo Payments — Test Mode replaces the old Razorpay wiring. Generate a
# test key at https://app.xalgorix.com/home → Developer → API Keys
# (with the Test Mode toggle on) and paste it here. Use the test
# hostname; live mode uses https://live.dodopayments.com instead. The
# single DODO_API_KEY follows whichever environment DODO_API_BASE_URL
# points at — no separate test/live key suffix.
DODO_API_BASE_URL=https://test.dodopayments.com
DODO_API_KEY=
DODO_WEBHOOK_SIGNING_SECRET=
DODO_PRO_PRODUCT_ID=

# ---------------------------------------------------------------------------
# Convex-side env vars (set with: npx convex env set <NAME> <value>)
# ---------------------------------------------------------------------------
# These do NOT belong in this .env file at runtime — they are listed here
# only as documentation of what the Convex deployment must have configured.
# Set each one against the active Convex deployment with:
#
#   npx convex env set <NAME> <value>
#
# Required:
#   FIREBASE_PROJECT_ID            — Firebase project ID, used by
#                                    convex/auth.config.ts to derive the
#                                    OIDC issuer (https://securetoken.google.com/<id>)
#                                    and the audience claim.
#   DODO_API_BASE_URL              — https://test.dodopayments.com or
#                                    https://live.dodopayments.com.
#   DODO_API_KEY                   — Dodo API key matching the base URL above.
#   DODO_WEBHOOK_SIGNING_SECRET    — Standard Webhooks signing secret from
#                                    the Dodo dashboard. Used by
#                                    convex/http.ts to verify webhook
#                                    payloads via the standardwebhooks
#                                    package.
#   DODO_PRO_PRODUCT_ID            — Dodo product id for HuntFlow Pro,
#                                    used by convex/dodo.ts when creating
#                                    a checkout session.
